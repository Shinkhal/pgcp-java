# Compiled class files (safety net for stray javac output)
*.class

# Package archives
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Build output
out/
bin/
build/
target/

# Logs and crash dumps
hs_err_pid*
replay_pid*
*.log

# IntelliJ IDEA
# Project config (.idea/misc.xml, .idea/modules.xml, .idea/vcs.xml, PGCPAI.iml)
# is intentionally tracked — only machine-local files are ignored here.
.idea/shelf/
.idea/httpRequests/
.idea/sonarlint/
.idea/dictionaries/
.idea/copilot/
*.iws
*.ipr

# Eclipse / NetBeans / VS Code
.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
.vscode/

# Kotlin
.kotlin

# OS junk
.DS_Store
Thumbs.db
.directory

# Editor backups and swap files
*~
*.bak
*.swp
*.swo
\#*\#
